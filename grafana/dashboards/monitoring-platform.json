    {
      "id": 4,
      "type": "table",
      "title": "Scrape target status",
      "description": "Prometheus scrape availability. User-facing availability is measured by Uptime Kuma.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "",
