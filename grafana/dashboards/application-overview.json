      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(django_http_requests_latency_seconds_by_view_method_sum{application=~\"$application\", environment=~\"$environment\"}[$__rate_interval])) / sum(rate(django_http_requests_latency_seconds_by_view_method_count{application=~\"$application\", environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
