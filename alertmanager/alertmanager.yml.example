# Alertmanager configuration example - NOT USED until Phase 2.
# Copy to alertmanager.yml (git-ignored) and fill in real values.
# Do not send real notifications during tests without approval.

global:
  resolve_timeout: 5m
  # smtp_smarthost: "smtp.example.com:587"
  # smtp_from: "monitoring@example.com"
  # smtp_auth_username: "CHANGE_ME"
  # smtp_auth_password: "CHANGE_ME"

route:
  receiver: default
  group_by: ["alertname", "application", "environment"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

inhibit_rules:
  - source_matchers: ['severity="critical"']
    target_matchers: ['severity="warning"']
    equal: ["alertname", "application", "environment"]

receivers:
  - name: default
    # email_configs:
    #   - to: "ops@example.com"
    #     send_resolved: true
