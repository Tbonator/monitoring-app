# Example: enabling email notifications.
# Merge into alertmanager.yml ONLY after approval (CLAUDE.md section 13).
# Put the SMTP password in secrets/smtp-password (git-ignored) and mount
# ./secrets into the alertmanager container at /etc/alertmanager/secrets.

global:
  resolve_timeout: 5m
  smtp_smarthost: "smtp.example.com:587"
  smtp_from: "monitoring@example.com"
  smtp_auth_username: "monitoring@example.com"
  smtp_auth_password_file: /etc/alertmanager/secrets/smtp-password
  smtp_require_tls: true

route:
  receiver: ops-email
  group_by: ["alertname", "application", "environment"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: ops-email
    email_configs:
      - to: "ops@example.com"
        send_resolved: true   # recovery notifications
