# Copy to .env and replace placeholders. NEVER commit .env.

# --- Image versions (pinned) ---
PROMETHEUS_VERSION=v3.16.0
GRAFANA_VERSION=13.3.2
UPTIME_KUMA_VERSION=2.5.12
ALERTMANAGER_VERSION=v0.35.1

# --- Ports (bound to 127.0.0.1) ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
UPTIME_KUMA_PORT=3001
ALERTMANAGER_PORT=9093

# --- Prometheus retention ---
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=5GB

# --- Grafana admin credentials ---
GRAFANA_ADMIN_USER=admin
# Use a long random value, e.g. generate with:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | % {[char]$_})
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# --- Phase 3: logging (Loki + Alloy) ---
LOKI_VERSION=3.7.10
ALLOY_VERSION=v1.22.0
LOKI_PORT=3100
# Directory on the host containing the Django JSON log file (read-only mount)
FUNERAL_APP_LOG_DIR=C:/path/to/funeralmanagementsystem/logs
FUNERAL_APP_ENVIRONMENT=development

# --- Phase 3: error tracking (GlitchTip) ---
GLITCHTIP_VERSION=6.2.6
GLITCHTIP_POSTGRES_VERSION=18.7
GLITCHTIP_PORT=8001
GLITCHTIP_RETENTION_DAYS=30
# Long random values (alphanumeric; the DB password is embedded in a URL)
GLITCHTIP_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
GLITCHTIP_DB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
# Initial GlitchTip admin (created by scripts\glitchtip-bootstrap.py)
GLITCHTIP_ADMIN_EMAIL=admin@glitchtip.localhost
GLITCHTIP_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
