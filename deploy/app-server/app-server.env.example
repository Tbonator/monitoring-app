# Copy to app-server.env on the APP server and edit. Contains no secrets.
# Private/VPN IP of THIS app server (agents listen here only).
APP_PRIVATE_IP=10.0.0.10
# Loki on the monitoring server, reached over the private network.
LOKI_PUSH_URL=http://10.0.0.20:3100/loki/api/v1/push
# Directory containing funeral-back-office-YYYY-MM-DD.log (APP_LOG_DIR of the Django app).
APP_LOG_DIR=/srv/funeral-back-office/logs
APP_ENVIRONMENT=production
ALLOY_VERSION=v1.22.0
NODE_EXPORTER_VERSION=v1.13.1
