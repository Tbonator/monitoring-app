# PRODUCTION environment for the monitoring server.
# On the server: copy to .env.prod (never commit it) and replace every
# placeholder, then:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d

# --- Public HTTPS (Caddy) ---
GRAFANA_DOMAIN=grafana.example.co.za
GLITCHTIP_DOMAIN=errors.example.co.za
# ACME e-mail for Let's Encrypt (expiry notices). Use "internal" ONLY for local tests.
CADDY_TLS=ops-team@example.co.za
CADDY_BIND=0.0.0.0
CADDY_VERSION=2.11.9-alpine

# --- Private network (app server <-> monitoring server) ---
# Private/VPN IP of THIS monitoring server: Loki listens here for Alloy on the app server.
LOKI_PRIVATE_BIND=10.0.0.20
LOKI_PRIVATE_PORT=3100

# --- Scrape targets ---
PROMETHEUS_TARGETS_DIR=./prometheus/targets/production

# --- Retention (review against operational, privacy and POPIA requirements) ---
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=20GB
LOKI_RETENTION_PERIOD=336h          # 14 days
GLITCHTIP_RETENTION_DAYS=30

# --- Credentials (generate fresh long random values for production) ---
GRAFANA_ADMIN_USER=CHANGE_ME_ADMIN_NAME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
GLITCHTIP_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
GLITCHTIP_DB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
GLITCHTIP_ADMIN_EMAIL=CHANGE_ME@example.co.za
GLITCHTIP_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
# GlitchTip outgoing mail (password reset): smtp://user:password@host:587
GLITCHTIP_EMAIL_URL=consolemail://
GLITCHTIP_FROM_EMAIL=glitchtip@example.co.za

# --- Files in secrets/ (not here) ---
#   secrets/funeral-back-office-metrics.token   same token as the app's MONITORING_METRICS_TOKEN
#   secrets/pg-monitor-password                 postgres-exporter (pg_monitor role)
#   secrets/smtp-password                       Alertmanager SMTP password

# --- Not used on the monitoring server in production (Alloy runs on the app server) ---
FUNERAL_APP_LOG_DIR=./exporters/textfile
